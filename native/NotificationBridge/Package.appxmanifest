 IgnorableNamespaces="uap uap3 uap10 rescap">
 <Identity Name="Sotuken.NotificationBridge" Publisher="CN=Sotuken" Version="1.0.0.0" ProcessorArchitecture="x64"/>
 <Properties><DisplayName>J.A.R.V.I.S. Notification Bridge</DisplayName><PublisherDisplayName>Sotuken</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo><uap10:AllowExternalContent>true</uap10:AllowExternalContent></Properties>
 <Dependencies><TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0"/></Dependencies>
 <Resources><Resource Language="ja-JP"/></Resources>
 <Applications><Application Id="App" Executable="NotificationBridge.exe" EntryPoint="Windows.FullTrustApplication">
 <uap:VisualElements DisplayName="J.A.R.V.I.S. Notification Bridge" Description="Windows通知をこのPCのJ.A.R.V.I.S.へ表示" BackgroundColor="#091724" Square150x150Logo="Assets\Logo150.png" Square44x44Logo="Assets\Logo44.png"/>
 </Application></Applications>
 <Capabilities><rescap:Capability Name="runFullTrust"/><uap3:Capability Name="userNotificationListener"/></Capabilities>
</Package>
